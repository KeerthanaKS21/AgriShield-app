GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# Get OpenWeatherMap API key at: https://openweathermap.org/api
OPENWEATHER_API_KEY="YOUR_OPENWEATHERMAP_API_KEY_HERE"
